{
	"extends": "./tsconfig.dependency.json",
	"compilerOptions": {
		"outDir": "../../packages/cli",
		"rootDir": ".",
		"composite": true,
		"target": "es2025",
		"module": "es2022",
		"moduleResolution": "bundler",
		"tsBuildInfoFile": "./tsBuild.info",
		"lib": [
			"ES2025"
		],
		"types": [
			"node"
		]
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"**/*.mts"
	],
	"files": [
		"index.ts"
	],
	"compileOnSave": true
}